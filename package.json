{
  "name": "dsh-acp-gateway",
  "version": "3.9.0",
  "description": "Distributable DSH (DeepSeek Harness) plugin exposing a full ACP v1 agent over stdio: streaming, tool calls, sessions, image/audio, slash commands, session modes, config options (model/thought level). Ships a one-command isolated ACP server.",
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./codec": "./dist/src/codec.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-acp-agent": "dist/src/bin/dsh-acp-agent.js",
    "dsh-acp-server": "dist/src/bin/dsh-acp-server.js",
    "dsh-acp-client": "dist/src/bin/dsh-acp-client.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/tests/*.test.js\""
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-app-boot": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "dsh",
    "deepseek-harness",
    "agent",
    "stdio"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "types": "dist/src/index.d.ts"
}
