{
  "name": "dsh-acp-gateway",
  "version": "3.8.0",
  "description": "Distributable DSH (DeepSeek Harness) plugin exposing a full ACP v1 agent over stdio: streaming, tool calls, sessions, image/audio, slash commands, session modes, config options (model/thought level). Ships a one-command isolated ACP server.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./codec": "./src/codec.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-acp-agent": "bin/dsh-acp-agent.js",
    "dsh-acp-server": "bin/dsh-acp-server.js",
    "dsh-acp-client": "bin/dsh-acp-client.js"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/",
    "check": "node --check src/index.js && node --check src/codec.js && node --check bin/dsh-acp-agent.js && node --check bin/dsh-acp-server.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-app-boot": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "dsh",
    "deepseek-harness",
    "agent",
    "stdio"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
